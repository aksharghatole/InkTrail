{
  "manifest_version": 3,
  "name": "InkTrail",
  "version": "0.9.0",
  "description": "Private manga, manhua and manhwa reading tracker.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "InkTrail",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "library.html",
    "open_in_tab": true
  }
}
